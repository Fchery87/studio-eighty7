# DeepSeek API key (tried first). Create one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Google Gemini API Key (fallback). Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (default: 8787)
PORT=8787

# Frontend URL for CORS (development: http://localhost:3000)
FRONTEND_URL=http://localhost:3000

# Node Environment (development or production)
NODE_ENV=development
